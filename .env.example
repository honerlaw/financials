# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=development

# Added automatically by setup.py after you connect each institution.
# Both the access token and item_id are stored — item_id is needed if you
# ever need to contact Plaid support about a stuck/orphaned item.
# PLAID_TOKEN_AMERICAN_EXPRESS=access-development-...
# PLAID_ITEM_AMERICAN_EXPRESS=item_xxxxxxxxxxxxxxxx
# PLAID_TOKEN_CITI_BANK=access-development-...
# PLAID_ITEM_CITI_BANK=item_xxxxxxxxxxxxxxxx
# PLAID_TOKEN_TRUIST=access-development-...
# PLAID_ITEM_TRUIST=item_xxxxxxxxxxxxxxxx

# IMPORTANT: Back up this file. If you lose it without running
# `python setup.py remove <slug>` first, those Items remain on Plaid's
# servers and count against your 100-item Development limit.
