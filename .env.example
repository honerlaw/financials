# ─────────────────────────────────────────────────────────────────────────────
# Configuration inventory
#
# These values are managed in DOPPLER (project `onerlaw` — a shared catch-all
# spanning multiple repos, not financials-specific), not by hand. This
# file is the canonical list of what a Doppler config must contain — see
# docs/doppler-migration.md for the full setup + cutover runbook.
#
# Local dev, two options:
#   1. Doppler (recommended): `doppler login && doppler setup` (uses doppler.yaml),
#      then run the app with `doppler run -- flask --app wsgi run`.
#   2. Plain .env: copy this file to `.env` and fill values in. The flask CLI
#      auto-loads `.env` (python-dotenv), and the app reads everything via
#      os.getenv, so this path still works unchanged.
#
# EXCEPTION — the database URLs below are NOT stored in Doppler. In production
# they are injected by DigitalOcean's managed-database binding; do not move them
# into Doppler (the entrypoint hands them precedence via --preserve-env).
# ─────────────────────────────────────────────────────────────────────────────

# Plaid credentials — https://dashboard.plaid.com/developers/keys
# Use PLAID_ENV=sandbox + sandbox secret for testing with fake data
# Use PLAID_ENV=production + production secret for real bank connections
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Web app
APP_PASSWORD=          # single password to log in to the web UI
SECRET_KEY=            # random 32-char string for session signing

# LLM chat (OpenRouter) — chat is disabled if OPENROUTER_API_KEY is unset
OPENROUTER_API_KEY=
# OPENROUTER_MODEL, OPENROUTER_BASE_URL, CHAT_MAX_ITERATIONS, CHAT_QUERY_ROW_LIMIT,
# CHAT_MODELS all have sensible defaults in app/__init__.py — override only if needed.

# Database — NOT in Doppler (see EXCEPTION above). Injected by DO App Platform in
# production; set manually for local dev.
DATABASE_URL=postgresql://user:pass@localhost:5432/financials
# DATABASE_ADMIN_URL=  # optional: privileged URL used only for `flask db upgrade`

# Wall-clock timezone for the 7am daily job and the digest's notion of "today".
# Defaults to America/New_York; the container sets no TZ, so leaving this to UTC
# would send the "good morning" text at 3am Eastern.
APP_TIMEZONE=America/New_York

# Daily digest SMS (optional) — texts each recipient once a day at 7am with the
# week's spend against the $1000 budget (including percent over) and every
# account's current balance. Leave any of these blank to disable texting
# entirely (the app runs inert). The FROM number must be a Twilio-provisioned
# number; US automated SMS also needs A2P 10DLC registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # E.164, e.g. +15551234567
BUDGET_ALERT_RECIPIENTS=        # digest recipients: comma-separated E.164, e.g. +15551112222,+15553334444

# Accounts excluded from the digest's net-worth total. Comma-separated
# `institution:account` patterns, matched case-insensitively: the institution half
# against the Plaid institution slug or display name (substring), the account half
# against the mask exactly or the account name (substring). BOTH halves must match,
# so a pattern is always anchored to one institution; drop the account half to
# exclude every account at a bank. An excluded account still appears in the text,
# marked `(not counted)`. Leave blank to count every account.
NET_WORTH_EXCLUDED_ACCOUNTS=    # e.g. sofi:checking,truist:9902

# ── Production only ──────────────────────────────────────────────────────────
# DOPPLER_TOKEN — a read-only, config-scoped Doppler service token. Set this in
# the DO App Platform dashboard (as a SECRET). When present, entrypoint.sh runs
# the app via `doppler run`; when absent, it falls back to plain env (above).
DOPPLER_TOKEN=
