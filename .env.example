# Plaid credentials — https://dashboard.plaid.com/developers/keys
# Use PLAID_ENV=sandbox + sandbox secret for testing with fake data
# Use PLAID_ENV=production + production secret for real bank connections
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Web app
APP_PASSWORD=          # single password to log in to the web UI
SECRET_KEY=            # random 32-char string for session signing

# Database — injected automatically by DO App Platform; set manually for local dev
DATABASE_URL=postgresql://user:pass@localhost:5432/financials

# Weekly-budget SMS alerts (optional) — texts each recipient once per week at
# 50%/75%/100% of the $1000 weekly budget. Leave any of these blank to disable
# alerting entirely (the app runs inert). The FROM number must be a
# Twilio-provisioned number; US automated SMS also needs A2P 10DLC registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # E.164, e.g. +15551234567
BUDGET_ALERT_RECIPIENTS=        # comma-separated E.164, e.g. +15551112222,+15553334444
